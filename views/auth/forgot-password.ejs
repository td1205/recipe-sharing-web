<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quên mật khẩu</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="auth-page">
    <div class="auth-container">
      <h1>Quên mật khẩu</h1>
      <% if(typeof error !== "undefined"){ %>
      <div class="error-msg"><%= error %></div>
      <%} %>
      <% if(typeof success !== "undefined"){ %>
      <div class="success-msg"><%= success %></div>
      <% } %>
      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label>Email đăng ký</label>
          <input
            type="email"
            name="email"
            placeholder="Nhập email của bạn..."
            required
          />
          <span class="input-hint">Nhập Email bạn đã từng đăng ký</span>
        </div>
        <button type="submit" class="btn-auth">Xác minh</button>
      </form>
      <div class="auth-footer">
        <p>
          Chưa có tài khoản?
          <a href="/register" class="auth-link">Đăng ký ngay</a>
        </p>
        <p>
          Nhớ mật khẩu rồi? <a href="/login" class="auth-link">Đăng nhập</a>
        </p>
      </div>
    </div>
  </body>
</html>
