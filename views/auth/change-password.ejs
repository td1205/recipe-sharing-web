<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đổi mật khẩu</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="auth-page">
    <div class="auth-container">
      <h1>Đổi mật khẩu</h1>
      <% if(typeof error !== "undefined"){ %>
      <div class="error-msg"><%= error %></div>
      <%} %>
      <% if(typeof success !== "undefined"){ %>
      <div class="success-msg"><%= success %></div>
      <% } %>
      <form action="/change-password" method="POST">
        <div class="form-group">
          <label>Mật khẩu mới</label>
          <div class="password-wrapper">
            <input
              type="password"
              name="password"
              placeholder="Nhập mật khẩu mới..."
              oncopy="return false;"
              onpaste="return false;"
              oncut="return false;"
              pattern='(?=.*\d)(?=.*[a-zA-Z])(?=.*[!@#$%^&*(),.?":{}|<>]).{8,}'
              title="Mật khẩu phải dài ít nhất 8 ký tự, bao gồm ít nhất 1 chữ cái, 1 chữ số và 1 ký tự đặc biệt"
              required
            />
            <i class="fa-solid fa-eye toggle-password-icon"></i>
          </div>
          <span class="input-hint"
            >Mật khẩu phải từ 8 ký tự trở lên, gồm chữ cái, chữ số và ký tự đặc
            biệt (ví dụ: @, #, $, %...)</span
          >
        </div>
        <div class="form-group">
          <label>Xác nhận mật khẩu mới</label>
          <div class="password-wrapper">
            <input
              type="password"
              name="confirm_password"
              placeholder="Nhập lại mật khẩu mới..."
              oncopy="return false;"
              onpaste="return false;"
              oncut="return false;"
              required
            />
            <i class="fa-solid fa-eye toggle-password-icon"></i>
          </div>
          <span class="input-hint"
            >Mật khẩu nhập lại phải trùng với mật khẩu mới</span
          >
        </div>
        <button type="submit" class="btn-auth">Đổi mật khẩu</button>
      </form>
    </div>
    <script src="/js/auth.js"></script>
  </body>
</html>
