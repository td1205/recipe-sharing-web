# Sao chép thành .env (cùng thư mục) rồi điền giá trị. KHÔNG commit file .env.

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=recipe_db
DATABASE_URL=mysql://root:@localhost:3306/recipe_db

# Chuỗi bí mật ký cookie phiên đăng nhập (chuỗi ngẫu nhiên dài)
SESSION_SECRET=

# Gmail gửi OTP quên mật khẩu (cần bật 2-Step Verification và tạo App password)
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Google Gemini – tìm món bằng ảnh. Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (Tuỳ chọn) danh sách model dự phòng cụ thể, cách nhau bởi dấu phẩy.
# Không dùng `gemini-flash-latest` làm fallback vì alias này có thể trỏ về model chính.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# (Tuỳ chọn) thời gian chờ mỗi model, mặc định 6000 ms để vừa với UI 35 giây.
# GEMINI_TIMEOUT_MS=6000

# Vận hành: chỉ trust IP/subnet của proxy thực tế; để trống khi chạy trực tiếp
PORT=3000
TRUST_PROXY=

# Bắt buộc ở production, ví dụ https://recipes.example.com (không dấu / cuối)
APP_ORIGIN=
