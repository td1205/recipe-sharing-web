generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categories {
  id             Int           @id @default(autoincrement())
  name           String        @unique(map: "name") @db.VarChar(100)
  description    String?       @db.Text
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  course_type_id Int?
  course_types   course_types? @relation(fields: [course_type_id], references: [id], onUpdate: NoAction, map: "categories_ibfk_1")
  recipes        recipes[]

  @@index([course_type_id], map: "course_type_id")
}

model comments {
  reports    content_reports[]
  id         Int       @id @default(autoincrement())
  user_id    Int
  recipe_id  Int
  content    String    @db.Text
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comments_ibfk_1")
  recipes    recipes   @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comments_ibfk_2")

  @@index([user_id], map: "user_id")
  @@index([recipe_id, created_at], map: "comments_recipe_created_idx")
}

model favorites {
  id         Int       @id @default(autoincrement())
  user_id    Int
  recipe_id  Int
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_ibfk_1")
  recipes    recipes   @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "favorites_ibfk_2")

  @@unique([user_id, recipe_id], map: "unique_user_recipe")
  @@index([recipe_id], map: "recipe_id")
}

model ingredients {
  id        Int     @id @default(autoincrement())
  recipe_id Int
  name      String  @db.VarChar(255)
  amount    String? @db.VarChar(50)
  unit      String? @db.VarChar(50)
  recipes   recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ingredients_ibfk_1")

  @@index([recipe_id], map: "recipe_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ratings {
  id         Int       @id @default(autoincrement())
  user_id    Int
  recipe_id  Int
  star_count Int
  created_at DateTime? @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ratings_ibfk_1")
  recipes    recipes   @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ratings_ibfk_2")

  @@unique([user_id, recipe_id], map: "unique_user_recipe_rating")
  @@index([recipe_id], map: "recipe_id")
  @@index([user_id], map: "user_id")
}

model recipes {
  reports        content_reports[]
  id             Int            @id @default(autoincrement())
  user_id        Int
  category_id    Int
  title          String         @db.VarChar(255)
  description    String?        @db.Text
  prep_time      Int
  cook_time      Int
  servings       Int
  image_url      String?        @db.VarChar(255)
  calories       Int?
  difficulty     String?        @db.VarChar(20)
  created_at     DateTime      @default(now()) @db.Timestamp(0)
  course_type_id Int?
  meal_time_id   Int?
  comments       comments[]
  favorites      favorites[]
  ingredients    ingredients[]
  ratings        ratings[]
  recipe_media   recipe_media[]
  recipe_views   recipe_views[]
  recipe_tags    recipe_tags[]
  user_tag_votes user_tag_votes[]
  users          users          @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "recipes_ibfk_1")
  categories     categories     @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "recipes_ibfk_2")
  meal_times     meal_times?    @relation(fields: [meal_time_id], references: [id], onUpdate: NoAction, map: "recipes_ibfk_3")
  course_types   course_types?  @relation(fields: [course_type_id], references: [id], onUpdate: NoAction, map: "recipes_ibfk_4")
  steps          steps[]

  @@index([user_id], map: "recipes_ibfk_1")
  @@index([meal_time_id], map: "meal_time_id")
  @@index([course_type_id], map: "course_type_id")
  @@index([created_at], map: "recipes_created_at_idx")
  @@index([category_id, created_at], map: "recipes_category_created_idx")
  @@index([meal_time_id, created_at], map: "recipes_meal_created_idx")
}

model course_types {
  id          Int          @id @default(autoincrement())
  name        String       @unique(map: "name") @db.VarChar(100)
  description String?      @db.Text
  created_at  DateTime?    @default(now()) @db.Timestamp(0)
  categories  categories[]
  recipes     recipes[]
}

model meal_times {
  id          Int       @id @default(autoincrement())
  name        String    @unique(map: "name") @db.VarChar(100)
  description String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(0)
  recipes     recipes[]
}

model sessions {
  session_id String  @id @db.VarChar(128)
  expires    Int     @db.UnsignedInt
  data       String? @db.MediumText
}

model steps {
  id          Int     @id @default(autoincrement())
  recipe_id   Int
  step_number Int
  instruction String  @db.Text
  recipes     recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "steps_ibfk_1")

  @@unique([recipe_id, step_number], map: "unique_recipe_step")
}

model users {
  reports      content_reports[] @relation("reporter")
  resolutions  content_reports[] @relation("resolver")
  id           Int         @id @default(autoincrement())
  username     String      @unique(map: "username") @db.VarChar(100)
  password     String      @db.VarChar(255)
  email        String      @unique(map: "email") @db.VarChar(100)
  fullname     String?     @db.VarChar(255)
  role         String?     @default("user") @db.VarChar(50)
  created_at   DateTime      @default(now()) @db.Timestamp(0)
  otp          String?     @db.Char(6)
  OTPExpiredAt DateTime?   @db.DateTime(0)
  OTPIsUsed    Boolean?    @default(dbgenerated("b'0'")) @db.Bit(1)
  is_banned    Boolean?    @default(false)
  avatar_url   String?     @db.VarChar(255)
  bio          String?     @db.Text

  comments     comments[]
  favorites    favorites[]
  ratings      ratings[]
  recipes      recipes[]
  recipe_views recipe_views[]
  user_tag_votes user_tag_votes[]

  @@index([created_at], map: "users_created_at_idx")
}

model recipe_views {
  id          Int      @id @default(autoincrement())
  recipe_id   Int
  user_id     Int?
  viewer_hash String   @db.Char(64)
  viewed_at   DateTime @default(now()) @db.Timestamp(0)
  recipes     recipes  @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?   @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([recipe_id, viewed_at])
  @@index([viewer_hash, recipe_id, viewed_at])
  @@index([user_id])
}



model recipe_media {
  id            Int                      @id @default(autoincrement())
  recipe_id     Int
  media_url     String                   @db.VarChar(255)
  media_type    recipe_media_media_type? @default(image)
  display_order Int?                     @default(0)
  created_at    DateTime?                @default(now()) @db.Timestamp(0)
  recipes       recipes                  @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recipe_media_ibfk_1")

  @@index([recipe_id], map: "recipe_id")
}

model recipe_tags {
  recipe_id Int
  tag_id    Int
  recipes   recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recipe_tags_ibfk_1")
  tags      tags    @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "recipe_tags_ibfk_2")

  @@id([recipe_id, tag_id])
  @@index([tag_id], map: "tag_id")
}

model tags {
  id          Int           @id @default(autoincrement())
  name        String        @unique(map: "name") @db.VarChar(50)
  type        String?       @default("community") @db.VarChar(50)
  created_at  DateTime?     @default(now()) @db.Timestamp(0)
  recipe_tags recipe_tags[]
  user_tag_votes user_tag_votes[]
}

enum recipe_media_media_type {
  image
  video
}

model user_tag_votes {
  user_id    Int
  recipe_id  Int
  tag_id     Int
  created_at DateTime? @default(now()) @db.Timestamp(0)

  users      users   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes    recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags    @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, recipe_id, tag_id])
  @@index([recipe_id])
  @@index([tag_id])
}

enum report_target {
  recipe
  comment
}

enum report_status {
  Pending
  Resolved
  Rejected
}

model content_reports {
  id           Int           @id @default(autoincrement())
  reporter_id  Int?
  target_type  report_target
  target_id    Int
  recipe_id    Int?
  comment_id   Int?
  reason       String        @db.VarChar(1000)
  status       report_status @default(Pending)
  created_at   DateTime      @default(now()) @db.DateTime(3)
  resolved_at  DateTime?     @db.DateTime(3)
  resolved_by  Int?
  reporter     users?        @relation("reporter", fields: [reporter_id], references: [id], onDelete: SetNull)
  resolver     users?        @relation("resolver", fields: [resolved_by], references: [id], onDelete: SetNull)
  recipe       recipes?      @relation(fields: [recipe_id], references: [id], onDelete: SetNull)
  comment      comments?     @relation(fields: [comment_id], references: [id], onDelete: SetNull)

  @@unique([reporter_id, target_type, target_id], map: "report_once_per_member_target")
  @@index([status, created_at])
  @@index([reporter_id, created_at])
  @@index([recipe_id])
  @@index([comment_id])
  @@index([resolved_by])
}

// IDs deliberately survive account/content deletion. No payload or credentials are stored.
model admin_audit_logs {
  id          Int      @id @default(autoincrement())
  admin_id    Int
  action      String   @db.VarChar(50)
  target_type String   @db.VarChar(20)
  target_id   Int
  created_at  DateTime @default(now()) @db.DateTime(3)

  @@index([created_at])
  @@index([admin_id, created_at])
  @@index([action, created_at])
  @@index([target_type, target_id])
}
